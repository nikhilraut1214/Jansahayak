# ==============================================================================
# JanSahayak Environment Configuration Template
# ==============================================================================
#
# IMPORTANT SECURITY NOTICE:
# In Vite applications, ANY variable prefixed with `VITE_` is statically embedded
# into the client-side JavaScript bundle at build time. It is fully visible to any
# user inspecting network requests or browser DevTools.
#
# - NEVER put private API secrets, database passwords, or private keys into VITE_ variables.
# - Environment files containing real credentials (.env, .env.local) must never be committed to Git.
#
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-EXPOSED FIREBASE CONFIGURATION (Vite Client Bundle)
# ------------------------------------------------------------------------------
# These client identifiers allow the frontend to connect to Firebase services.
# Ensure that your Firebase Web API key is properly restricted in Google Cloud Console
# (API restrictions: Identity Toolkit, Cloud Firestore; Application restrictions: HTTP Referrers).
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="stone-smoke-w6shk.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="stone-smoke-w6shk"
VITE_FIREBASE_STORAGE_BUCKET="stone-smoke-w6shk.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="691383501881"
VITE_FIREBASE_APP_ID="1:691383501881:web:1a1317b7af9690b469f9e8"
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-jansahayak-00e3a8b6-6e54-43f5-a445-ecf9ac2ead24"

# Application hosting URL (used for CORS, redirects, and self-referencing endpoints)
APP_URL="http://localhost:3000"

